    private async Task PingSecsHost()
    {
        try
        {
            var client = AuthState.GetClient();
            await client.PostAsync("/api/fab/secslogs/inject?direction=IN&msgType=S1F1&hex=00 00 00 0A 00 01 01 01 00 00&desc=Online check request from Host client terminal.", null);
            await client.PostAsync("/api/fab/secslogs/inject?direction=OUT&msgType=S1F2&hex=00 00 00 0A 00 01 01 02 00 00&desc=Online acknowledgement response. Equipment online.", null);
            await RefreshSecsLogs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending SECS ping: {ex.Message}");
        }
    }

