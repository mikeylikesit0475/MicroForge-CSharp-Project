@page "/login"
@layout LoginLayout
@inject AuthStateProvider AuthState
@inject NavigationManager Navigation

<div class="login-box">
    <h1>MicroForge</h1>
    <p>AI-Powered Manufacturing Intelligence</p>

    @if (_error != null)
    {
        <div class="login-error">@_error</div>
    }

    <EditForm Model="@_model" OnValidSubmit="@DoLogin" class="login-form">
        <div class="form-group">
            <label for="username">Username</label>
            <InputText id="username" @bind-Value="_model.Username" placeholder="Enter username" />
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <InputText id="password" type="password" @bind-Value="_model.Password" placeholder="Enter password" />
        </div>
        <button type="submit" class="btn" disabled="@_loading">
            @if (_loading)
            { <span>Signing in...</span> }
            else
            { <span>Sign In</span> }
        </button>
    </EditForm>

    <div class="mt-16 text-sm text-muted">
        Demo accounts: admin / engineer / operator (password: Password123!)
    </div>
</div>

@code {
    private LoginModel _model = new();
    private string? _error;
    private bool _loading;

    private async Task DoLogin()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        var success = await AuthState.LoginAsync(_model.Username, _model.Password);
        if (success)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            _error = "Invalid username or password.";
        }

        _loading = false;
        StateHasChanged();
    }

    private class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}