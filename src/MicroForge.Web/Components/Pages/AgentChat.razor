@page "/agent"
@inject AuthStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>AI Agent — MicroForge</PageTitle>

<h1 class="page-title">AI Agent Chat</h1>

@if (!(AuthState.IsAdmin || AuthState.IsEngineer))
{
    <div class="access-denied">
        <h2>Access Restricted</h2>
        <p>The AI Agent is available to Admin and Engineer roles only.</p>
    </div>
}
else
{
    <div style="display: flex; justify-content: flex-end; align-items: center; gap: 8px; margin-bottom: 8px;">
        <span class="text-sm text-muted">Active LLM Model:</span>
        @if (_showCustomModelInput)
        {
            <input @bind="_customModel" placeholder="Enter custom model..." style="padding: 4px 8px; font-size: 14px; border: 1px solid #ccc; border-radius: 4px; max-width: 200px;" />
            <button class="btn btn-secondary text-sm" style="padding: 4px 8px;" @onclick="ToggleCustomModel">Presets</button>
        }
        else
        {
            <select @onchange="OnModelChanged" style="padding: 4px 8px; font-size: 14px; border: 1px solid #ccc; border-radius: 4px; background: white;">
                @foreach (var model in _availableModels)
                {
                    <option value="@model" selected="@(model == _selectedModel)">@model</option>
                }
                <option value="custom">Custom...</option>
            </select>
        }
    </div>

    <div class="chat-container">
        <div class="chat-messages" id="chatScroll">
            @foreach (var msg in _messages)
            {
                <div class="chat-message @(msg.IsUser ? "user" : "agent")">
                    <div>@msg.Text</div>
                    @if (msg.Tools.Count > 0)
                    {
                        <div class="tools">Tools: @string.Join(", ", msg.Tools)</div>
                    }
                    @if (msg.DurationMs > 0)
                    {
                        <div class="tools">Duration: @msg.DurationMs ms</div>
                    }
                </div>
            }
            @if (_thinking)
            {
                <div class="chat-message agent">
                    <div>Agent is thinking...</div>
                </div>
            }
        </div>

        <div class="chat-input">
            <input @bind="_input" placeholder="Ask the AI agent..." @onkeypress="OnKeyPress" disabled="@_thinking" />
            <button class="btn" @onclick="Send" disabled="@(_thinking || string.IsNullOrWhiteSpace(_input))">
                @if (_thinking) { <span>Sending...</span> } else { <span>Send</span> }
            </button>
        </div>
    </div>

    <div class="card mt-16">
        <div class="card-header">
            <span class="card-title">Recent Interactions</span>
        </div>
        @if (_history.Count == 0)
        {
            <div class="empty-state">No recent interactions.</div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Message</th>
                        <th>Tools</th>
                        <th>Time</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in _history)
                    {
                        <tr>
                            <td>@(log.UserMessage.Length > 60 ? log.UserMessage[..60] + "..." : log.UserMessage)</td>
                            <td class="text-sm">@log.ToolsInvoked</td>
                            <td class="text-sm text-muted">@log.Timestamp.ToString("MM/dd HH:mm")</td>
                            <td>
                                @if (log.IsSuccess)
                                { <span class="badge badge-success">Success</span> }
                                else
                                { <span class="badge badge-danger">Failed</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private List<ChatMessage> _messages = new();
    private string _input = string.Empty;
    private bool _thinking;
    private List<AgentLogSummary> _history = new();
    private string _selectedModel = "glm 5.2:cloud";
    private string _customModel = "";
    private bool _showCustomModelInput;
    private List<string> _availableModels = new()
    {
        "glm 5.2:cloud",
        "llama3.1",
        "llama3.2",
        "qwen2.5",
        "mock-model"
    };

    private string GetModelToUse()
    {
        if (_showCustomModelInput || _selectedModel == "custom")
        {
            return string.IsNullOrWhiteSpace(_customModel) ? "glm 5.2:cloud" : _customModel.Trim();
        }
        return _selectedModel;
    }

    private void ToggleCustomModel()
    {
        _showCustomModelInput = !_showCustomModelInput;
        if (!_showCustomModelInput)
        {
            _selectedModel = "glm 5.2:cloud";
        }
    }

    private void OnModelChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "glm 5.2:cloud";
        if (val == "custom")
        {
            _showCustomModelInput = true;
            _selectedModel = "custom";
        }
        else
        {
            _selectedModel = val;
            _showCustomModelInput = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (AuthState.IsAdmin || AuthState.IsEngineer)
        {
            try
            {
                var client = AuthState.GetClient();
                _history = await client.GetFromJsonAsync<List<AgentLogSummary>>("/api/agent/history?limit=10") ?? new();
                
                var models = await client.GetFromJsonAsync<List<string>>("/api/agent/models");
                if (models != null && models.Count > 0)
                {
                    _availableModels = models;
                    _selectedModel = models.Contains("glm 5.2:cloud") ? "glm 5.2:cloud" : models.First();
                }
            }
            catch { }
        }
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_input) || _thinking)
            return;

        var userMessage = _input;
        _messages.Add(new ChatMessage { Text = userMessage, IsUser = true });
        _input = string.Empty;
        _thinking = true;
        StateHasChanged();

        try
        {
            var client = AuthState.GetClient();
            var request = new AgentRequestDto 
            { 
                Message = userMessage, 
                SessionId = Guid.NewGuid().ToString(),
                Model = GetModelToUse()
            };
            var response = await client.PostAsJsonAsync("/api/agent/chat", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AgentResponseDto>();
                _messages.Add(new ChatMessage
                {
                    Text = result?.Response ?? "No response received.",
                    IsUser = false,
                    Tools = result?.ToolsInvoked ?? new(),
                    DurationMs = result?.DurationMs ?? 0
                });
            }
            else
            {
                _messages.Add(new ChatMessage
                {
                    Text = $"Error: Agent returned status {response.StatusCode}.",
                    IsUser = false
                });
            }
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessage
            {
                Text = $"Error: {ex.Message}",
                IsUser = false
            });
        }
        finally
        {
            _thinking = false;
            StateHasChanged();
        }
    }

    private async Task OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Send();
    }

    private class ChatMessage
    {
        public string Text { get; set; } = string.Empty;
        public bool IsUser { get; set; }
        public List<string> Tools { get; set; } = new();
        public decimal DurationMs { get; set; }
    }
}