{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=microforge.db"
  },
  "Jwt": {
    "Issuer": "MicroForge",
    "Audience": "MicroForge-Client",
    "SecretKey": "MicroForge-Development-Secret-Key-32-Chars!!",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Rag": {
    "ChunkSizeTokens": 500,
    "ChunkOverlapTokens": 50,
    "TopK": 5,
    "EmbeddingDimension": 384
  },
  "Agent": {
    "MaxIterations": 10,
    "PerToolTimeoutSeconds": 30,
    "SessionTimeoutSeconds": 120,
    "LlmProvider": "ollama",
    "LlmApiKey": "none",
    "LlmModel": "glm-5.2:cloud",
    "LlmEndpoint": "http://localhost:11434"
  },
  "Sensor": {
    "IntervalSeconds": 5,
    "AutoStart": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}