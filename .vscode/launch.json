{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/MicroForge.Web/bin/Debug/net8.0/MicroForge.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/MicroForge.Web",
            "stopAtEntry": false,
            "console": "internalConsole",
            "launchBrowser": {
                "enabled": true,
                "args": "${auto-detect-url}",
                "windows": {
                    "command": "cmd.exe /c start ${url}",
                    "args": "/C start ${url}"
                },
                "osx": {
                    "command": "open",
                    "args": "${url}"
                },
                "linux": {
                    "command": "xdg-open",
                    "args": "${url}"
                }
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}